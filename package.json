{
  "name": "@lupinum/ginko-editor",
  "version": "0.1.0",
  "description": "A portable Vue editor for Ginko content.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://ginko-editor.lupinum.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko-editor.git"
  },
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko-editor/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "import": "./dist/collaboration.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./agent-docs": "./dist/agent/AGENTS.md"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:library": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly && node scripts/fix-declaration-imports.mjs",
    "build": "pnpm build:library && pnpm docs:build && pnpm docs:agent",
    "changeset": "changeset",
    "docs:build": "pnpm --dir docs build",
    "docs:agent": "node scripts/agent-docs.mjs",
    "dev": "pnpm build:library && pnpm docs:dev",
    "docs:dev": "pnpm --dir docs dev",
    "lint": "eslint . && node scripts/lint-changesets.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:packed": "node scripts/test-packed.mjs",
    "test:compat": "pnpm build:library && pnpm typecheck && pnpm test",
    "typecheck": "vue-tsc --noEmit",
    "verify": "pnpm audit:all && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:packed",
    "audit:all": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@lupinum/ginko-content": "1.0.0-beta.10",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^29.1.1",
    "pkg-pr-new": "0.0.87",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "8.1.5",
    "vitest": "^4.1.8",
    "vue": "3.5.42",
    "vue-tsc": "^3.3.7",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@lupinum/ginko-content": ">=1.0.0-beta.10 <2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "vue": "^3.5.40"
  },
  "peerDependenciesMeta": {
    "@tiptap/vue-3": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@lucide/vue": "1.24.0",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "prosemirror-collab": "1.3.1",
    "reka-ui": "2.10.1"
  }
}
