:root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #20251f; background: #f7f8f6; font-synthesis: none; }
* { box-sizing: border-box; }
body { margin: 0; }
main { max-width: 1440px; margin: auto; padding: 40px 28px 80px; }
header { margin-bottom: 36px; }
.eyebrow { color: #547248; font-size: 12px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
h1 { font-size: clamp(26px, 4vw, 42px); letter-spacing: -.04em; margin: 12px 0; }
header > p:last-child { color: #62675e; }
.writers { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.writer-heading { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; }
h2 { font-size: 18px; margin: 0; }
.writer-heading > span { font-size: 12px; color: #6d7268; }
.writer-heading > button { margin-left: auto; }
button { font: inherit; cursor: pointer; padding: 7px 11px; background: white; border: 1px solid #d9ded5; border-radius: 7px; font-size: 12px; }
.peers { margin: 0 0 10px; font-size: 12px; color: #6d7268; }
details { margin-top: 18px; font-size: 12px; color: #6d7268; }
pre { overflow: auto; white-space: pre-wrap; line-height: 1.6; }
@media (max-width: 800px) { .writers { grid-template-columns: 1fr; } main { padding: 24px 16px; } }
