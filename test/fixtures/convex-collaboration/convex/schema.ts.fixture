import { defineSchema, defineTable } from 'convex/server'
import { v } from 'convex/values'

export default defineSchema({
  documents: defineTable({ markdown: v.string(), epoch: v.string(), version: v.number(),
    published: v.optional(v.string()), publishedEpoch: v.optional(v.string()), publishedVersion: v.optional(v.number()) }),
  rooms: defineTable({ documentId: v.id('documents'), document: v.string(), epoch: v.string(), generation: v.number(),
    schemaRevision: v.string(), policyRevision: v.string(), version: v.number(), minimumVersion: v.number() }),
  members: defineTable({ roomId: v.id('rooms'), identity: v.string(), role: v.union(v.literal('owner'), v.literal('editor'), v.literal('reader')) })
    .index('by_room_identity', ['roomId', 'identity']),
  steps: defineTable({ roomId: v.id('rooms'), epoch: v.string(), version: v.number(), clientId: v.string(), steps: v.array(v.string()) })
    .index('by_room_epoch_version', ['roomId', 'epoch', 'version']),
})
