import { defineConfig } from 'vite'
import vue from '@vitejs/plugin-vue'
import { config, token } from './auth.mjs'

export default defineConfig({
  plugins: [vue(), { name: 'synthetic-local-auth', configureServer(server) {
    server.middlewares.use((req, res, next) => {
      const match = /^\/test-auth\/(alice|bob)$/.exec(req.url ?? '')
      if (!match) return next()
      res.setHeader('Content-Type', 'application/json')
      res.setHeader('Cache-Control', 'no-store')
      res.end(JSON.stringify({ token: token(match[1]), url: config.url }))
    })
  } }],
  server: { host: '127.0.0.1', port: 4323, strictPort: true },
})
