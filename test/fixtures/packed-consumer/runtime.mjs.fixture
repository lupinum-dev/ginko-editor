import assert from 'node:assert/strict'
import { registerHooks } from 'node:module'

// A Node import alone can hide accidental Vue dependencies. Reject UI imports
// throughout the transitive graph so this entry stays usable by backend code.
registerHooks({
  resolve(specifier, context, nextResolve) {
    assert.ok(!/^(vue(?:\/|$)|@vue\/|@tiptap\/vue-3|reka-ui)/.test(specifier),
      `The document runtime imported UI code: ${specifier}`)
    return nextResolve(specifier, context)
  },
})

const { createEditorSchema, prepareMarkdownForVisualEditing, convertTiptapDocToMarkdown,
  SetNodePropertyStep, SetComponentVariantStep, SetNodeAttributeStep,
  createCollaborationSnapshot, decodeCollaborationDocument, applyCollaborationSteps } =
  await import('@lupinum/ginko-editor/runtime')
assert.equal(typeof document, 'undefined')
const schema = createEditorSchema()
const prepared = await prepareMarkdownForVisualEditing('# Server checkpoint\n\nKeep **this**.', undefined, schema)
assert.equal(prepared.ok, true, JSON.stringify(prepared.issues))
const doc = schema.nodeFromJSON(prepared.value)
doc.check()
const serialized = await convertTiptapDocToMarkdown(doc.toJSON())
assert.equal(serialized.ok, true, JSON.stringify(serialized.issues))
const reopened = await prepareMarkdownForVisualEditing(serialized.value, undefined, schema)
assert.deepEqual(reopened.value, prepared.value)

const { Step, Transform } = await import('@tiptap/pm/transform')
const component = schema.nodeFromJSON({ type: 'doc', content: [{ type: 'element',
  attrs: { tag: 'note', props: { title: 'Before' } }, content: [{ type: 'paragraph' }] }] })
const property = Step.fromJSON(schema, new SetNodePropertyStep(0, 'title', 'After').toJSON())
const edited = property.apply(component).doc
assert.equal(edited.firstChild.attrs.props.title, 'After')
const variant = Step.fromJSON(schema, new SetComponentVariantStep(0, 'warning', undefined).toJSON())
assert.equal(variant.apply(edited).doc.firstChild.attrs.tag, 'warning')
const code = schema.nodeFromJSON({ type: 'doc', content: [{ type: 'codeBlock', attrs: { language: 'ts', filename: 'before.ts' } }] })
const attribute = Step.fromJSON(schema, new SetNodeAttributeStep(0, 'filename', 'after.ts').toJSON())
assert.equal(attribute.apply(code).doc.firstChild.attrs.filename, 'after.ts')
assert.equal(attribute.apply(code).doc.firstChild.attrs.language, 'ts')

// The archive pair must preserve accepted pre-origin room JSON when Content's
// implicit default changes. Parsing source first would conceal this regression.
const options = { epoch: 'packed-legacy', policyRevision: 'notes-1', policy: { version: 2, components: {
  note: { kind: 'block', props: {}, slots: ['default'], allowedParents: null, allowedChildren: null, media: null },
} } }
const seeded = await createCollaborationSnapshot('::note\nBody\n::\n\nAfter', options)
const stored = schema.nodeFromJSON({ type: 'doc', content: [
  { type: 'element', attrs: { tag: 'note', props: {} }, content: [
    { type: 'paragraph', content: [{ type: 'text', text: 'Body' }] },
  ] },
  { type: 'paragraph', content: [{ type: 'text', text: 'After' }] },
] })
const snapshot = { ...seeded.snapshot, document: JSON.stringify(stored.toJSON()) }
const loaded = decodeCollaborationDocument(snapshot.document)
const unrelated = new Transform(loaded).insert(loaded.firstChild.nodeSize + 1, loaded.type.schema.text('Unrelated '))
const accepted = await applyCollaborationSteps(snapshot, { ...snapshot, clientId: 'packed/session',
  steps: unrelated.steps.map(step => JSON.stringify(step.toJSON())),
}, options)
assert.equal(accepted.markdown, '::note\nBody\n::\n\nUnrelated After\n')
assert.deepEqual(JSON.parse(accepted.snapshot.document), unrelated.doc.toJSON())
assert.deepEqual(JSON.parse(accepted.snapshot.document).content[0].attrs.props, {})
