{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "replace",
  "schedule": ["before 6am on Monday"],
  "github-actions": { "enabled": false },
  "packageRules": [
    { "description": "Keep Nuxt and Vue updates together", "groupName": "Nuxt ecosystem", "matchPackageNames": ["nuxt", "@nuxt/**", "vue", "vue-router"] },
    { "description": "Keep TipTap and ProseMirror updates together so hosts share one editor runtime", "groupName": "TipTap and ProseMirror", "matchPackageNames": ["@tiptap/**", "prosemirror-*"] }
  ]
}
