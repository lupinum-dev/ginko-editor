{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am on Monday"
  ],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on Monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": [
        "@changesets/**"
      ],
      "groupName": "Changesets"
    },
    {
      "matchPackageNames": [
        "@tiptap/**"
      ],
      "groupName": "TipTap"
    },
    {
      "matchPackageNames": [
        "@lupinum/ginko-content",
        "@lupinum/ginko-docs"
      ],
      "groupName": "Ginko docs stack"
    },
    {
      "matchPackageNames": [
        "@vitejs/plugin-vue",
        "vue",
        "vue-tsc"
      ],
      "groupName": "Vue toolchain"
    }
  ]
}
